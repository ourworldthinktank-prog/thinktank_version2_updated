# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.org

# Official Bharat Summit website (opens in a new tab)
NEXT_PUBLIC_BHARAT_SUMMIT_URL=https://https://bharatsummit.co/

# Set to "true" ONLY at launch. Anything else keeps the site noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Sanity (fill in once the client's Sanity project exists)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Forms (fill in once accounts exist; keep server-side only)
TURNSTILE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
FORM_NOTIFY_TO=
FORM_NOTIFY_FROM=
